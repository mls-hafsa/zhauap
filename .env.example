# Адрес API для сайта.
#
# Локальная разработка (этот файл -> .env):
VITE_API_URL=http://localhost:5000
#
# Production на Vercel (Settings -> Environment Variables), рекомендуется:
#   VITE_API_URL=/                                — запросы через прокси на домене сайта
#                                                   (src/routes/api/$.ts); вход работает в Safari/iPhone
#   API_PROXY_TARGET=https://zhauap.onrender.com  — куда прокси пересылает /api/* (по умолчанию так и есть)
#
# Старый вариант без прокси: VITE_API_URL=https://zhauap.onrender.com (сторонний cookie, Safari блокирует).
