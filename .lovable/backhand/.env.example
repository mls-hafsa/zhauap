# Скопируйте в .env для локального запуска. В production задайте те же
# переменные в Render -> Environment. Реальные значения в git не коммитьте.

# --- обязательные ---
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Имя бота без @ (для ссылок клиентам)
BOT_USERNAME=zhauapai_bot
# Ключ Google AI Studio
GEMINI_API_KEY=
# Секрет, который Telegram присылает в заголовке webhook. Любая длинная случайная строка.
TELEGRAM_WEBHOOK_SECRET=

# --- рекомендуемые ---
# Токен для внешнего планировщика /api/internal/tick (случайная строка)
INTERNAL_TICK_TOKEN=
# Адреса сайта, которым разрешено обращаться к API (через запятую)
FRONTEND_ORIGINS=https://zhauap.vercel.app

# --- необязательные (значения по умолчанию указаны) ---
# MONGO_DB_NAME=zhauap_database
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=15
# GEMINI_DEADLINE_SECONDS=35
# MANUAL_TIMEOUT_MINUTES=10
# ENABLE_BACKGROUND_TICK=true
# TICK_INTERVAL_SECONDS=30
# SESSION_DAYS=30
# TRIAL_DAYS=14
# RECEIPTS_DIR=receipts
# SESSION_COOKIE_SAMESITE=None   # в production; Lax, если API проксируется через домен сайта
# ALLOW_LOCALHOST_ORIGINS=false  # в production localhost запрещён по умолчанию
# PUBLIC_BASE_URL=               # адрес backend для webhook, если не Render (на Render берётся RENDER_EXTERNAL_URL)
